{
  "name": "bulk-email-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade MERN SaaS application",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "rollup": "4.46.2"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/client\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/client && npm run build --workspace=apps/server",
    "start": "npm run start --workspace=apps/server",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') { const { execSync } = require('child_process'); try { execSync('husky'); } catch (e) {} }\""
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}