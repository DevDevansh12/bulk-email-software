# ─────────────────────────────────────────────────────────────────────────────
# Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development

# Server
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173
# Public-facing URL of this server — used to build email tracking links.
# Production example: https://yourdomain.com
# Leave empty in development (falls back to http://localhost:PORT).
SERVER_URL=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Get from: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your_jwt_secret

# Token expiry (informational — Supabase manages actual session TTLs)
JWT_ACCESS_EXPIRES_IN=15m

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Email (SMTP) — system default for campaigns of users without their own SMTP
# settings, and for transactional emails. In development, leaving SMTP_HOST empty
# uses an Ethereal TEST inbox (nothing is delivered). In production an empty
# SMTP_HOST means campaigns without user SMTP fail with a clear error.
# Port 465 = implicit TLS, 587 = STARTTLS (required).
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Feature flags
ENABLE_SWAGGER=true

# AI Keys (Optional - QuillBot Assistant falls back to rules-based rephraser if not set)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── WhatsApp Cloud API (system default — optional) ───────────────────────────
# Users can also save their own credentials in Settings → WhatsApp Config,
# which take precedence over these.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Webhook verify token (any random string, also entered in the Meta App Dashboard)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret — verifies X-Hub-Signature-256 on webhook calls (required in production)
WHATSAPP_APP_SECRET=
# Development only: record WhatsApp sends as clearly-labeled simulations when no
# credentials are configured (nothing is sent; never counted as delivered).
WHATSAPP_SIMULATION_MODE=false

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# Secret key for authenticating cron job requests (e.g., from cron-job.org)
# Generate a secure random string and keep it private
CRON_SECRET=
