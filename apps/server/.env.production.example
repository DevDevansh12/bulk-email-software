# ─────────────────────────────────────────────────────────────────────────────
# Production Server Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for production deployment and fill in your values.
# NEVER commit real production secrets to version control.
#
# DEPLOYMENT CHECKLIST:
# □ Change all default secrets to strong random values
# □ Update CLIENT_URL to your production domain
# □ Configure HTTPS at reverse proxy (nginx, ALB, Cloudflare)
# □ Rotate Supabase service role key if it was ever exposed
# □ Set LOG_LEVEL to 'info' or 'warn' (not 'debug')
# □ Generate new CRON_SECRET using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# Runtime - MUST be 'production'
NODE_ENV=production

# Server
PORT=5000
API_VERSION=v1

# ── IMPORTANT: Production Frontend Origin ────────────────────────────────────
# MUST match your deployed frontend domain(s).
# Multiple origins: separate with commas (no spaces)
# Examples:
#   Single domain:  https://yourdomain.com
#   Multiple:       https://yourdomain.com,https://www.yourdomain.com
#   Staging + Prod: https://staging.yourdomain.com,https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# ── Public Server URL ─────────────────────────────────────────────────────────
# Used to build email tracking links and WhatsApp callbacks.
# MUST match your production domain with HTTPS.
SERVER_URL=https://api.yourdomain.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
# WARNING: Keep service role key secret - it bypasses RLS!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_production_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# Get from: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your_production_jwt_secret

# Token expiry (informational — Supabase manages actual session TTLs)
JWT_ACCESS_EXPIRES_IN=15m

# ── Rate Limiting (Production - Stricter) ─────────────────────────────────────
# Window: 15 minutes (900000 ms)
# Max requests: 100 per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logging (Production - Less Verbose) ───────────────────────────────────────
# Options: fatal, error, warn, info, debug, trace
# Recommended: 'info' or 'warn' in production
LOG_LEVEL=info

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Production SMTP credentials (e.g., SendGrid, AWS SES, Gmail)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Disable Swagger in production for security
ENABLE_SWAGGER=false

# ── AI Keys (Optional) ────────────────────────────────────────────────────────
# QuillBot Assistant - provide at least one key for AI features
GEMINI_API_KEY=your_production_gemini_key
OPENAI_API_KEY=your_production_openai_key

# ── WhatsApp (System Default - Optional) ──────────────────────────────────────
# Production Meta/WhatsApp Business API credentials
WHATSAPP_PHONE_NUMBER_ID=your_production_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_production_meta_access_token
WHATSAPP_WABA_ID=your_production_waba_id
# Graph API version used for every Meta call (Meta retires versions ~2 years after release)
WHATSAPP_GRAPH_API_VERSION=v23.0
# Webhook (delivery/read receipts). REQUIRED for delivered/read counts.
# Verify token: any random string; enter the same value in Meta App Dashboard → WhatsApp → Configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate_a_random_verify_token
# App Secret: Meta App Dashboard → App settings → Basic → App secret.
# Required in production — unsigned webhook POSTs are rejected without it.
WHATSAPP_APP_SECRET=your_meta_app_secret
# Simulation is development-only and is ignored when NODE_ENV=production.
WHATSAPP_SIMULATION_MODE=false

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# CRITICAL: Generate a NEW secret for production!
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This authenticates cron job requests from external services (cron-job.org)
CRON_SECRET=generate_a_new_secret_for_production

# ─────────────────────────────────────────────────────────────────────────────
# HTTPS / SSL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# This Node.js server does NOT handle HTTPS directly.
# SSL/TLS termination MUST be configured at the reverse proxy layer:
#
# Option 1: nginx
#   - Install Let's Encrypt certificate (certbot)
#   - Configure nginx to proxy to http://localhost:5000
#
# Option 2: AWS Application Load Balancer (ALB)
#   - Add ACM certificate to ALB
#   - Forward to target group (this server)
#   - Enable "trust proxy" in Express (already configured)
#
# Option 3: Cloudflare
#   - Add your domain to Cloudflare
#   - Set SSL mode to "Full" or "Full (strict)"
#   - Point A/CNAME record to your server IP
#
# Option 4: Hostinger with cPanel
#   - Use AutoSSL to generate Let's Encrypt certificate
#   - Configure Node.js app deployment
#   - Set up reverse proxy in cPanel
#
# For more details, see: docs/PRODUCTION-DEPLOYMENT.md
# ─────────────────────────────────────────────────────────────────────────────
