# ─────────────────────────────────────────────────────────────────────────────
# Client Environment Variables
# Copy this file to .env and fill in your values.
# All VITE_ vars are exposed to the browser — do NOT put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Express API base URL
# Development: http://localhost:5000 (for separate dev servers)
# Production: Leave empty or omit (uses relative URLs when served from same domain)
VITE_API_URL=http://localhost:5000

# ── Supabase (public — safe to expose in browser) ─────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# App metadata
VITE_APP_NAME=Bulk Email Platform
VITE_APP_VERSION=1.0.0
