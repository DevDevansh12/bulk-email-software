# ─────────────────────────────────────────────────────────────────────────────
# Production Environment Variables
# For deployment where React and Express are served from the same domain
# ─────────────────────────────────────────────────────────────────────────────

# API URL: Leave empty to use relative URLs (same domain deployment)
# The app will make requests to /api/v1/* on the same domain
VITE_API_URL=

# ── Supabase (Production) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_anon_key

# App metadata
VITE_APP_NAME=Bulk Email Platform
VITE_APP_VERSION=1.0.0
